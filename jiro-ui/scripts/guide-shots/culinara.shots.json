  {
    "name": "meal-planner",
    "path": "/culinara/meal-planner",
    "waitFor": ".calendar-grid"
  },
  {
    "name": "planner-picker",
    "path": "/culinara/meal-planner",
    "waitFor": ".calendar-grid",
    "actions": [
      {
        "click": ".calendar-cell:nth-of-type(14) .cell-add"
      },
      {
        "fill": "#planner-recipe-search",
        "value": "oat"
      },
      {
        "wait": 200
      }
    ],
    "clip": ".modal-content"
  },
  {
    "name": "grocery-list",
    "path": "/culinara/grocery-list",
    "waitFor": ".shop-item"
  }
