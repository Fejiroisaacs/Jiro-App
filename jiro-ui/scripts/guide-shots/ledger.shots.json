  {
    "name": "delete-category",
    "path": "/ledger/budgets",
    "waitFor": ".cm-row",
    "actions": [
      {
        "click": {
          "role": "button",
          "name": "Delete Entertainment"
        }
      },
      {
        "wait": 400
      }
    ],
    "clip": ".modal-content"
  },
  {
    "name": "net-worth",
    "path": "/ledger/net-worth",
    "waitFor": ".chart-card canvas",
    "actions": [
      {
        "wait": 1500
      }
    ]
  },
  {
    "name": "compare",
